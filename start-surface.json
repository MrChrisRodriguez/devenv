{
	"schemaVersion": 1,
	"mode": "skeleton",
	"tsconfigPath": "tsconfig.start.base.json",
	"devServer": "wrangler",
	"viteDevWaiver": null,
	"proxyRegistryPath": "proxy-routes.json",
	"types": [],
	"forbiddenTypes": ["@tanstack/react-router/globals"],
	"ssr": {
		"mode": "buffered",
		"streamingWaiver": null,
		"methods": ["GET", "HEAD"],
		"methodRejection": {
			"status": 405,
			"allowHeader": "GET, HEAD"
		},
		"cacheControl": "private, no-store",
		"determinism": {
			"timezone": "UTC",
			"locale": "en-US"
		}
	},
	"worker": {
		"compatibilityDate": "2025-01-01",
		"compatibilityFlags": ["nodejs_compat"],
		"workersDev": false,
		"previewUrls": false,
		"serviceBindings": [],
		"forbiddenBindingKinds": [
			"d1_databases",
			"kv_namespaces",
			"r2_buckets",
			"durable_objects",
			"secrets_store_secrets",
			"unsafe"
		],
		"harnessOnlyVariables": []
	},
	"build": {
		"outputDirectory": "dist",
		"clientDirectory": "dist/client",
		"serverModule": "index.js",
		"builtConfigPath": "dist/server/wrangler.json",
		"assetsDirectory": "../client",
		"assetsPrefix": "_start/assets",
		"buildTimeVariables": []
	},
	"router": {
		"defaultPreload": false,
		"defaultErrorComponent": true,
		"scrollRestoration": true,
		"caseSensitive": true
	},
	"apps": []
}

# Shared shell configuration for both bash and zsh
# This file contains common aliases and configurations

# Navigation aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

# Color grep aliases
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Git aliases
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gb='git branch'
alias gco='git checkout'

# Bun aliases
alias bi='bun install'
alias ba='bun add'
alias br='bun remove'
alias bd='bun add -d'
alias bs='bun start'
alias bt='bun test'

# Proto aliases
alias protolist='proto list'
alias protoinstall='proto install'
alias protoupdate='proto outdated'

# Claude Code and development productivity aliases
alias rg='rg --color=always'
alias bcat='batcat --paging=never'
alias bless='batcat --paging=always'
alias find='fd'
alias tree='tree -I node_modules'
alias search='fzf --preview "batcat --color=always {}"'
alias claude-config='code ~/.clauderc'
alias claude-docs='code /workspace/CLAUDE.md'
alias claude-auto='claude --dangerously-skip-permissions'

# Other aliases

# Default working directory (SSH lands in $HOME; this brings us to the workspace)
[[ "$PWD" == "$HOME" ]] && cd /workspace

# PROTO_HOME and PATH are NOT set here. The image bakes them as ENV and
# .devcontainer/environment.sh (sourced by .bashrc/.zshrc before this file)
# re-asserts them idempotently. This file stays interactive-only: aliases,
# completions, and terminal-scoped signals.

# Common function to load tool completions
load_completions() {
    local shell_type="$1"
    [[ -f ~/.config/moon/completions.${shell_type} ]] && source ~/.config/moon/completions.${shell_type}
    [[ -f ~/.config/proto/completions.${shell_type} ]] && source ~/.config/proto/completions.${shell_type}
    [ -f ~/.fzf.${shell_type} ] && source ~/.fzf.${shell_type}
}

# Load Claude Code configuration
[[ -f ~/.clauderc ]] && source ~/.clauderc

# Secrets are NOT sourced here. They arrive two ways, both value-safe:
#   • Docker --env-file (host-side .devcontainer/host/prepare-container-env.sh)
#     puts them in the container's process environment for every reader,
#     including the VS Code extension host and MCP subprocesses.
#   • .devcontainer/environment.sh re-reads the host bind-mount at
#     /run/devcontainer-config through the strict KEY=value parser in
#     .devcontainer/lib/env-file.sh, so keys added AFTER container create reach
#     new shells without a rebuild. Neither path evaluates the file as shell.

# capability:start claude_warp
# Warp ACP signals — captured on the host by initializeCommand
# (.devcontainer/host/capture-warp-env.sh), refreshed on every container start.
# `set -a` exports them so Claude Code (a child of this shell) inherits the
# Warp signals and switches to ACP structured output. Sourced here rather than
# in environment.sh because they're only needed in interactive shells, and this
# picks up refreshed values on every new shell with no rebuild. The snapshot of
# `$-` keeps `set +a` from clearing allexport for a caller that already had it
# on (a sourcing script running under `set -a`).
if [[ -f /run/devcontainer-config/warp-env ]]; then
    _warp_allexport_was_on=""
    case "$-" in *a*) _warp_allexport_was_on=1 ;; esac
    set -a
    source /run/devcontainer-config/warp-env
    [[ -n "$_warp_allexport_was_on" ]] || set +a
    unset _warp_allexport_was_on
fi
# capability:end claude_warp

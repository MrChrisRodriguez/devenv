{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"stage",
		"capturedAt",
		"run",
		"source",
		"host",
		"repository",
		"commands",
		"guards",
		"gateSemantics",
		"renderGraph",
		"live",
		"branchProtection",
		"coverage",
		"rollback"
	],
	"properties": {
		"schemaVersion": { "const": 1 },
		"stage": { "const": "stage-7-ci-bootstrap" },
		"capturedAt": { "type": "string", "format": "date-time" },
		"run": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "logRoot"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^stage7-[0-9]{8}t[0-9]{6}z-[0-9a-f]{8}$"
				},
				"logRoot": { "const": "evidence/stage-7-ci-run" }
			}
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["baseSha", "implementationSha", "treeClean"],
			"properties": {
				"baseSha": { "$ref": "#/$defs/gitSha" },
				"implementationSha": { "$ref": "#/$defs/gitSha" },
				"treeClean": { "const": true }
			}
		},
		"host": {
			"type": "object",
			"additionalProperties": false,
			"required": ["os", "architecture", "kernel", "ghVersion"],
			"properties": {
				"os": { "enum": ["darwin", "linux"] },
				"architecture": { "type": "string", "minLength": 3 },
				"kernel": { "type": "string", "minLength": 1 },
				"ghVersion": { "$ref": "#/$defs/version" }
			}
		},
		"repository": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"nameWithOwner",
				"protectedBranch",
				"workflowFile",
				"gateJobId",
				"gateContext",
				"gateNeeds",
				"negativeBranch"
			],
			"properties": {
				"nameWithOwner": {
					"type": "string",
					"pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
				},
				"protectedBranch": { "type": "string", "minLength": 1 },
				"workflowFile": { "const": ".github/workflows/ci.yml" },
				"gateJobId": { "const": "ci-gate" },
				"gateContext": { "type": "string", "minLength": 1 },
				"gateNeeds": {
					"type": "array",
					"minItems": 2,
					"items": { "type": "string", "minLength": 1 }
				},
				"negativeBranch": {
					"type": "string",
					"pattern": "^evidence/[a-z0-9-]+$"
				}
			}
		},
		"commands": {
			"type": "array",
			"minItems": 9,
			"maxItems": 9,
			"items": { "$ref": "#/$defs/commandResult" }
		},
		"guards": {
			"type": "object",
			"additionalProperties": false,
			"required": ["contract", "mutations"],
			"properties": {
				"contract": {
					"type": "object",
					"additionalProperties": false,
					"required": ["commandId", "command", "summary"],
					"properties": {
						"commandId": { "const": "ci-guard" },
						"command": { "const": "bun run ci:check" },
						"summary": { "type": "string", "minLength": 40 }
					}
				},
				"mutations": {
					"type": "object",
					"additionalProperties": false,
					"required": ["commandId", "testFile", "passCount", "failCount"],
					"properties": {
						"commandId": { "const": "workflow-policy-mutations" },
						"testFile": { "const": "scripts/template/__tests__/ci.test.ts" },
						"passCount": { "type": "integer", "minimum": 12 },
						"failCount": { "const": 0 }
					}
				}
			}
		},
		"gateSemantics": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"commandId",
				"script",
				"draftMessage",
				"greenOutput",
				"cases"
			],
			"properties": {
				"commandId": { "const": "gate-semantics" },
				"script": { "const": "scripts/ci/aggregate-gate.sh" },
				"draftMessage": { "type": "string", "minLength": 40 },
				"greenOutput": { "type": "string", "minLength": 20 },
				"cases": {
					"type": "array",
					"minItems": 7,
					"maxItems": 7,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"name",
							"results",
							"draft",
							"expectedExitCode",
							"observedExitCode"
						],
						"properties": {
							"name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
							"results": { "type": "string" },
							"draft": { "enum": ["", "true", "false"] },
							"expectedExitCode": { "type": "integer", "minimum": 0 },
							"observedExitCode": { "type": "integer", "minimum": 0 }
						}
					}
				}
			}
		},
		"renderGraph": {
			"type": "object",
			"additionalProperties": false,
			"required": ["commandId", "fixtures"],
			"properties": {
				"commandId": { "const": "rendered-workflow-graph" },
				"fixtures": {
					"type": "array",
					"minItems": 3,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"name",
							"workflows",
							"jobs",
							"gateContext",
							"gateNeeds",
							"errors"
						],
						"properties": {
							"name": { "type": "string", "minLength": 1 },
							"workflows": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "string",
									"pattern": "^\\.github/workflows/[a-z0-9-]+\\.ya?ml$"
								}
							},
							"jobs": {
								"type": "array",
								"minItems": 2,
								"items": { "type": "string", "minLength": 1 }
							},
							"gateContext": { "type": "string", "minLength": 1 },
							"gateNeeds": {
								"type": "array",
								"minItems": 1,
								"items": { "type": "string", "minLength": 1 }
							},
							"errors": { "type": "array", "maxItems": 0 }
						}
					}
				}
			}
		},
		"live": {
			"type": "object",
			"additionalProperties": false,
			"required": ["green", "red", "draft"],
			"properties": {
				"green": {
					"allOf": [{ "$ref": "#/$defs/liveRun" }],
					"required": ["commandId"],
					"properties": {
						"commandId": { "const": "live-gate-green" },
						"conclusion": { "const": "success" },
						"gateConclusion": { "const": "success" }
					}
				},
				"red": {
					"allOf": [{ "$ref": "#/$defs/liveRun" }],
					"required": [
						"failedJob",
						"branchDeleted",
						"injectedFiles",
						"injectedNumstat",
						"injectedLines"
					],
					"properties": {
						"commandId": { "const": "live-gate-red" },
						"conclusion": { "const": "failure" },
						"gateConclusion": { "const": "failure" },
						"failedJob": { "type": "string", "minLength": 1 },
						"branchDeleted": { "const": true },
						"injectedFiles": { "type": "string", "minLength": 1 },
						"injectedNumstat": { "type": "string", "minLength": 1 },
						"injectedLines": { "type": "string", "minLength": 1 }
					}
				},
				"draft": {
					"allOf": [{ "$ref": "#/$defs/liveRun" }],
					"required": ["isDraft", "pullRequest", "pullRequestClosed"],
					"properties": {
						"commandId": { "const": "live-gate-draft" },
						"conclusion": { "const": "failure" },
						"gateConclusion": { "const": "failure" },
						"event": { "const": "pull_request" },
						"isDraft": { "const": true },
						"pullRequest": { "type": "integer", "minimum": 1 },
						"pullRequestClosed": { "const": true }
					}
				}
			}
		},
		"branchProtection": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"commandId",
				"branch",
				"contexts",
				"strict",
				"enforceAdmins",
				"requiredPullRequestReviews",
				"restrictions",
				"applyCommand",
				"removeCommand"
			],
			"properties": {
				"commandId": { "const": "branch-protection" },
				"branch": { "type": "string", "minLength": 1 },
				"contexts": {
					"type": "array",
					"minItems": 1,
					"maxItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"strict": { "const": true },
				"enforceAdmins": { "const": false },
				"requiredPullRequestReviews": { "const": false },
				"restrictions": { "const": false },
				"applyCommand": { "$ref": "#/$defs/command" },
				"removeCommand": { "$ref": "#/$defs/command" }
			}
		},
		"coverage": {
			"type": "array",
			"minItems": 8,
			"maxItems": 8,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "task", "status", "reason", "commandIds"],
				"properties": {
					"id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
					"task": { "type": "string", "minLength": 10 },
					"status": { "enum": ["proven", "not-applicable"] },
					"reason": { "type": "string", "minLength": 40 },
					"commandIds": {
						"type": "array",
						"items": { "type": "string", "minLength": 1 }
					}
				}
			}
		},
		"rollback": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"mode",
				"command",
				"outsideTheTree",
				"containerRebuildRequired",
				"scope",
				"proof"
			],
			"properties": {
				"mode": { "const": "atomic" },
				"command": { "$ref": "#/$defs/command" },
				"outsideTheTree": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/command" }
				},
				"containerRebuildRequired": { "const": false },
				"scope": { "type": "string", "minLength": 40 },
				"proof": {
					"type": "object",
					"required": [
						"commandId",
						"predecessorSha",
						"implementationSha",
						"predecessorTree",
						"revertedTree",
						"treeMatchesPredecessor",
						"addedPaths",
						"addedPathsRemoved"
					],
					"properties": {
						"treeMatchesPredecessor": { "const": true },
						"addedPathsRemoved": { "const": true },
						"addedPaths": {
							"type": "array",
							"minItems": 1,
							"items": { "type": "string", "minLength": 1 }
						}
					}
				}
			}
		}
	},
	"$defs": {
		"gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
		"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"version": {
			"type": "string",
			"pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$"
		},
		"command": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		},
		"liveRun": {
			"type": "object",
			"required": [
				"commandId",
				"runId",
				"url",
				"event",
				"headBranch",
				"headSha",
				"conclusion",
				"gateJobId",
				"gateConclusion",
				"gateLogSha256",
				"upstreamResults",
				"gateVerdict",
				"jobs"
			],
			"properties": {
				"commandId": { "type": "string", "minLength": 1 },
				"runId": { "type": "integer", "minimum": 1 },
				"url": { "type": "string", "pattern": "^https://github\\.com/" },
				"event": { "enum": ["workflow_dispatch", "pull_request", "push"] },
				"headBranch": { "type": "string", "minLength": 1 },
				"headSha": { "$ref": "#/$defs/gitSha" },
				"conclusion": { "enum": ["success", "failure"] },
				"gateJobId": { "type": "integer", "minimum": 1 },
				"gateConclusion": { "enum": ["success", "failure"] },
				"gateLogSha256": { "$ref": "#/$defs/sha256" },
				"upstreamResults": { "type": "string" },
				"gateVerdict": { "type": "string" },
				"jobs": {
					"type": "array",
					"minItems": 2,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["name", "conclusion"],
						"properties": {
							"name": { "type": "string", "minLength": 1 },
							"conclusion": {
								"enum": ["success", "failure", "skipped", "cancelled"]
							}
						}
					}
				}
			}
		},
		"commandResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"command",
				"runId",
				"startedAt",
				"completedAt",
				"durationMs",
				"stdoutPath",
				"stderrPath",
				"stdoutSha256",
				"stderrSha256",
				"exitCode",
				"status"
			],
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"command": { "$ref": "#/$defs/command" },
				"runId": { "type": "string", "minLength": 1 },
				"startedAt": { "type": "string", "format": "date-time" },
				"completedAt": { "type": "string", "format": "date-time" },
				"durationMs": { "type": "integer", "minimum": 1 },
				"stdoutPath": {
					"type": "string",
					"pattern": "^evidence/stage-7-ci-run/[a-z0-9-]+\\.stdout$"
				},
				"stderrPath": {
					"type": "string",
					"pattern": "^evidence/stage-7-ci-run/[a-z0-9-]+\\.stderr$"
				},
				"stdoutSha256": { "$ref": "#/$defs/sha256" },
				"stderrSha256": { "$ref": "#/$defs/sha256" },
				"exitCode": { "const": 0 },
				"status": { "const": "pass" }
			}
		}
	}
}

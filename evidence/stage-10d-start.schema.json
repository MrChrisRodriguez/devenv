{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"stage",
		"capturedAt",
		"run",
		"source",
		"host",
		"repository",
		"commands",
		"guards",
		"suites",
		"typecheckProof",
		"renderFixtures",
		"live",
		"coverage",
		"rollback"
	],
	"properties": {
		"schemaVersion": { "type": "integer", "const": 1 },
		"stage": { "type": "string", "const": "stage-10d-start" },
		"capturedAt": { "type": "string", "format": "date-time" },
		"run": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "logRoot"],
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"logRoot": { "type": "string", "const": "evidence/stage-10d-start-run" }
			}
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"baseSha",
				"implementationSha",
				"treeClean",
				"declaredMode",
				"devServer",
				"ssrMode",
				"repairedTsconfig",
				"forbiddenTypes",
				"cloudflareFamily",
				"buildToolPeerRange",
				"lockfileChanged",
				"harnessBindPort",
				"harnessListeners",
				"typescriptCatalogPin"
			],
			"properties": {
				"baseSha": { "$ref": "#/$defs/gitSha" },
				"implementationSha": { "$ref": "#/$defs/gitSha" },
				"treeClean": { "type": "boolean", "const": true },
				"declaredMode": { "type": "string", "const": "skeleton" },
				"devServer": {
					"description": "The built worker under the pinned command-line tool, not a bundler dev server. Declared rather than assumed because the two answers differ in kind: under a dev server the worker runtime resolves modules at request time and fails the server render with a module-resolution error the build does not have.",
					"type": "string",
					"const": "wrangler"
				},
				"ssrMode": {
					"description": "Buffered, because this worker runtime's backpressure and abort behaviour under a stream is unproven. That is a statement about a date rather than a law, which is why the guard makes streaming a waivable refusal rather than an impossibility.",
					"type": "string",
					"const": "buffered"
				},
				"repairedTsconfig": {
					"type": "string",
					"const": "tsconfig.start.base.json"
				},
				"forbiddenTypes": {
					"description": "The type entry this base carried since Stage 0. It names a subpath the router package does not export, so `tsc` fails on it with TS2688 — and nothing reported it for four stages, because the build ignores `types` entirely and no project in this repository extends the file.",
					"type": "array",
					"minItems": 1,
					"maxItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"cloudflareFamily": {
					"description": "The coupled family, with the resolutions measured at capture time. Five members already existed; `vite` is the one this stage adds, because the Cloudflare plugin IS the Vite plugin the requirement names and its whole job is to be loaded by a build tool nothing governed.",
					"type": "object",
					"additionalProperties": false,
					"required": [
						"@cloudflare/vite-plugin",
						"@cloudflare/vitest-pool-workers",
						"wrangler",
						"miniflare",
						"workerd",
						"vite"
					],
					"properties": {
						"@cloudflare/vite-plugin": { "$ref": "#/$defs/version" },
						"@cloudflare/vitest-pool-workers": { "$ref": "#/$defs/version" },
						"wrangler": { "$ref": "#/$defs/version" },
						"miniflare": { "$ref": "#/$defs/version" },
						"workerd": { "$ref": "#/$defs/version" },
						"vite": { "$ref": "#/$defs/version" }
					}
				},
				"buildToolPeerRange": {
					"description": "The plugin's OWN declared peer range, read out of the lock rather than typed into the guard, so the rule cannot go stale against a plugin upgrade.",
					"type": "string",
					"minLength": 1
				},
				"lockfileChanged": {
					"description": "False. Catalog-pinning the build tool is what the reference implementation recommends and it would have changed this — it would also put a build-tool pin in a template that runs no build. The rule closes the same hole without the pin, and this is the fourth consecutive stage with an empty lockfile diff.",
					"type": "boolean",
					"const": false
				},
				"harnessBindPort": {
					"description": "The port every executed-harness listener ASKS for, not the ephemeral value the kernel handed back. An ephemeral number is a fact about one run on one machine and is evidence of nothing; \"every listener asked for port zero\" is the property that keeps two worktrees from colliding, and it is checkable against the committed fixture.",
					"type": "integer",
					"const": 0
				},
				"harnessListeners": {
					"description": "Two: the server-rendering upstream and the apex proxy in front of it. One origin is the whole point — production serves the document and the mutation from the same public origin, so a harness with two origins would be testing a topology nobody ships.",
					"type": "integer",
					"const": 2
				},
				"typescriptCatalogPin": { "$ref": "#/$defs/version" }
			}
		},
		"host": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"os",
				"architecture",
				"kernel",
				"insideDevcontainer",
				"bunVersion",
				"gitVersion",
				"ghVersion"
			],
			"properties": {
				"os": { "type": "string", "minLength": 1 },
				"architecture": { "type": "string", "minLength": 1 },
				"kernel": { "type": "string", "minLength": 1 },
				"insideDevcontainer": { "type": "boolean" },
				"bunVersion": { "$ref": "#/$defs/version" },
				"gitVersion": { "$ref": "#/$defs/version" },
				"ghVersion": { "$ref": "#/$defs/version" }
			}
		},
		"repository": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"nameWithOwner",
				"workflowFile",
				"gateJobId",
				"gateContext",
				"gateNeeds",
				"startGuardScript",
				"familyGuardScript",
				"ciGuardScript",
				"registryFile",
				"capability",
				"capabilityDependencies",
				"addedJobs",
				"devcontainerFilesChanged"
			],
			"properties": {
				"nameWithOwner": { "type": "string", "minLength": 1 },
				"workflowFile": {
					"type": "string",
					"const": ".github/workflows/ci.yml"
				},
				"gateJobId": { "type": "string", "const": "ci-gate" },
				"gateContext": { "type": "string", "minLength": 1 },
				"gateNeeds": {
					"type": "array",
					"minItems": 2,
					"items": { "type": "string", "minLength": 1 }
				},
				"startGuardScript": { "type": "string", "const": "start:check" },
				"familyGuardScript": { "type": "string", "const": "toolchain:check" },
				"ciGuardScript": { "type": "string", "const": "ci:check" },
				"registryFile": { "type": "string", "const": "start-surface.json" },
				"capability": { "type": "string", "const": "tanstack_start" },
				"capabilityDependencies": {
					"description": "The first capability in this template with declared dependencies, which is what forced the rule this stage writes down: a gated module may import core or same-capability modules only, and a declared dependency earns the right to READ a dependency's committed registry file with a named notice when it is absent — nothing more.",
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "type": "string", "minLength": 1 }
				},
				"addedJobs": { "type": "integer", "const": 0 },
				"devcontainerFilesChanged": {
					"description": "Zero, measured rather than promised. `scripts/worktree/contract.toml` names `.devcontainer` — the whole directory — as a definition fingerprint input, and the Dockerfile bakes that directory in as a definition stamp, so a single byte here would cost every downstream developer a container rebuild.",
					"type": "integer",
					"const": 0
				}
			}
		},
		"commands": {
			"type": "array",
			"minItems": 19,
			"maxItems": 19,
			"items": { "$ref": "#/$defs/commandResult" }
		},
		"guards": {
			"type": "object",
			"additionalProperties": false,
			"required": ["start", "family", "ci"],
			"properties": {
				"start": { "$ref": "#/$defs/guardSummary" },
				"family": { "$ref": "#/$defs/guardSummary" },
				"ci": { "$ref": "#/$defs/guardSummary" }
			}
		},
		"suites": {
			"type": "array",
			"minItems": 13,
			"maxItems": 13,
			"items": { "$ref": "#/$defs/suiteCounts" }
		},
		"typecheckProof": {
			"description": "The executed compiler proof. A build-based proof of this repair would have been green against the broken file, because esbuild ignores `types` entirely — so the proof has to be the typechecker, run for real over a synthetic project that genuinely extends the repaired base with no `node_modules` at all.",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"commandId",
				"forbiddenEntry",
				"mutationDiagnostic",
				"staleIncludeDiagnostic",
				"passCount"
			],
			"properties": {
				"commandId": { "type": "string", "const": "tsconfig-typecheck" },
				"forbiddenEntry": {
					"type": "string",
					"const": "@tanstack/react-router/globals"
				},
				"mutationDiagnostic": { "type": "string", "const": "TS2688" },
				"staleIncludeDiagnostic": { "type": "string", "const": "TS18003" },
				"passCount": { "type": "integer", "minimum": 2 }
			}
		},
		"renderFixtures": {
			"type": "object",
			"additionalProperties": false,
			"required": ["commandId", "fixtures"],
			"properties": {
				"commandId": { "type": "string", "const": "rendered-start" },
				"fixtures": {
					"type": "array",
					"minItems": 3,
					"maxItems": 3,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"name",
							"capabilityEnabled",
							"cloudflareEnabled",
							"gatedPaths",
							"packageScripts",
							"startStepPresent",
							"guardPresent",
							"repairedTsconfigPresent",
							"startTokenFiles",
							"startErrors",
							"buildToolFamilyPresent",
							"residueFindings"
						],
						"properties": {
							"name": { "type": "string", "minLength": 1 },
							"capabilityEnabled": { "type": "boolean" },
							"cloudflareEnabled": { "type": "boolean" },
							"gatedPaths": {
								"type": "array",
								"items": { "type": "string", "minLength": 1 }
							},
							"packageScripts": {
								"type": "array",
								"items": { "type": "string", "minLength": 1 }
							},
							"startStepPresent": { "type": "boolean" },
							"guardPresent": { "type": "boolean" },
							"repairedTsconfigPresent": { "type": "boolean" },
							"startTokenFiles": { "type": "integer", "minimum": 0 },
							"startErrors": {
								"type": "array",
								"maxItems": 0,
								"items": { "type": "string" }
							},
							"buildToolFamilyPresent": {
								"description": "Whether the rendered core toolchain guard still carries the coupled build-tool family legs. True wherever Cloudflare is enabled INCLUDING the render where this capability is off, which is the assertion that proves the family is core rather than gated.",
								"type": "boolean"
							},
							"residueFindings": {
								"type": "array",
								"maxItems": 0,
								"items": { "type": "object" }
							}
						}
					}
				}
			}
		},
		"live": {
			"type": "object",
			"additionalProperties": false,
			"required": ["live-gate"],
			"properties": {
				"live-gate": {
					"type": "object",
					"additionalProperties": false,
					"required": ["commandId", "heavyLaneRan", "run"],
					"properties": {
						"commandId": { "type": "string", "const": "live-gate" },
						"heavyLaneRan": { "type": "boolean", "const": true },
						"run": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"runId",
								"url",
								"event",
								"headBranch",
								"headSha",
								"conclusion",
								"gateJobId",
								"gateConclusion",
								"gateLogSha256",
								"upstreamResults",
								"jobs"
							],
							"properties": {
								"runId": { "type": "integer", "minimum": 1 },
								"url": { "type": "string", "minLength": 1 },
								"event": { "type": "string", "const": "pull_request" },
								"headBranch": { "type": "string", "minLength": 1 },
								"headSha": { "$ref": "#/$defs/gitSha" },
								"conclusion": { "type": "string", "const": "success" },
								"gateJobId": { "type": "integer", "minimum": 1 },
								"gateConclusion": { "type": "string", "const": "success" },
								"gateLogSha256": { "$ref": "#/$defs/sha256" },
								"upstreamResults": { "type": "string", "minLength": 1 },
								"jobs": {
									"type": "array",
									"minItems": 1,
									"items": { "$ref": "#/$defs/jobResult" }
								}
							}
						}
					}
				}
			}
		},
		"coverage": {
			"type": "array",
			"minItems": 12,
			"maxItems": 12,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "task", "reason", "commandIds"],
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"task": { "type": "string", "minLength": 1 },
					"reason": { "type": "string", "minLength": 40 },
					"commandIds": {
						"type": "array",
						"minItems": 1,
						"items": { "type": "string", "minLength": 1 }
					}
				}
			}
		},
		"rollback": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"mode",
				"command",
				"outsideTheTree",
				"containerRebuildRequired",
				"scope",
				"proof"
			],
			"properties": {
				"mode": { "type": "string", "const": "atomic" },
				"command": { "$ref": "#/$defs/command" },
				"outsideTheTree": {
					"type": "array",
					"maxItems": 0,
					"items": { "type": "string" }
				},
				"containerRebuildRequired": {
					"description": "False, and it is a decision rather than luck. `scripts/worktree/contract.toml` names `.devcontainer` — the whole directory — as a definition fingerprint input, so Stage 10B paid a rebuild for a comment-only edit to a file the image never reads. This stage refuses to add an advertised port, and the reason is stronger than the previous one: the port a worker of this stack runs on under the pinned development command is 8787, which the parameter file already advertises under `cloudflare_workers` — and this capability REQUIRES that one, so every profile that can enable it already advertises the port. A second entry would be a duplicate under a narrower gate. The record carries the measured `devcontainerFilesChanged` count rather than the promise.",
					"type": "boolean",
					"const": false
				},
				"scope": { "type": "string", "minLength": 80 },
				"proof": {
					"type": "object",
					"additionalProperties": true,
					"required": [
						"commandId",
						"predecessorSha",
						"implementationSha",
						"treeMatchesPredecessor",
						"addedPaths",
						"addedPathsRemoved",
						"repairedTsconfigRestored"
					],
					"properties": {
						"commandId": { "type": "string", "const": "rollback-proof" },
						"predecessorSha": { "$ref": "#/$defs/gitSha" },
						"implementationSha": { "$ref": "#/$defs/gitSha" },
						"treeMatchesPredecessor": { "type": "boolean", "const": true },
						"addedPaths": {
							"type": "array",
							"minItems": 4,
							"maxItems": 4,
							"items": { "type": "string", "minLength": 1 }
						},
						"addedPathsRemoved": { "type": "boolean", "const": true },
						"repairedTsconfigRestored": {
							"description": "The asymmetric half. Stage 0 created the shared TypeScript base and this stage REPAIRS it, so a revert restores the broken version rather than deleting the file — which is why the base is not in `addedPaths` and is proved separately.",
							"type": "boolean",
							"const": true
						}
					}
				}
			}
		}
	},
	"$defs": {
		"gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
		"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"version": { "type": "string", "minLength": 1 },
		"command": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string" }
		},
		"commandResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"command",
				"runId",
				"startedAt",
				"completedAt",
				"durationMs",
				"stdoutPath",
				"stderrPath",
				"stdoutSha256",
				"stderrSha256",
				"exitCode",
				"status"
			],
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"command": { "$ref": "#/$defs/command" },
				"runId": { "type": "string", "minLength": 1 },
				"startedAt": { "type": "string", "format": "date-time" },
				"completedAt": { "type": "string", "format": "date-time" },
				"durationMs": { "type": "number", "minimum": 1 },
				"stdoutPath": { "type": "string", "minLength": 1 },
				"stderrPath": { "type": "string", "minLength": 1 },
				"stdoutSha256": { "$ref": "#/$defs/sha256" },
				"stderrSha256": { "$ref": "#/$defs/sha256" },
				"exitCode": { "type": "number", "const": 0 },
				"status": { "type": "string", "const": "pass" }
			}
		},
		"guardSummary": {
			"type": "object",
			"additionalProperties": false,
			"required": ["commandId", "command", "summary"],
			"properties": {
				"commandId": { "type": "string", "minLength": 1 },
				"command": { "type": "string", "minLength": 1 },
				"summary": { "type": "string", "minLength": 20 }
			}
		},
		"suiteCounts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["commandId", "testFile", "passCount", "failCount"],
			"properties": {
				"commandId": { "type": "string", "minLength": 1 },
				"testFile": { "type": "string", "minLength": 1 },
				"passCount": { "type": "number", "minimum": 1 },
				"failCount": { "type": "number", "const": 0 }
			}
		},
		"jobResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "conclusion"],
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"conclusion": { "type": "string", "minLength": 1 }
			}
		}
	}
}
